<?xml version="1.0" encoding="utf-8"?>
<!--
  ABOUTME: Android manifest for the GC2 Android Plugin library.
  ABOUTME: Declares USB host feature, foreground service, and required permissions.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for USB Host API access to communicate with GC2 launch monitor -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- USB permission for accessing the GC2 device -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />

    <!-- Required for foreground service (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required for connected device foreground service (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Required for data sync foreground service when GC2 not connected (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required for wake lock to keep USB alive when screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required for notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          USB device filter for automatic app launch when GC2 is connected.
          This meta-data references the usb_device_filter.xml resource which
          specifies the GC2's Vendor ID (0x2C79) and Product ID (0x0110).
        -->
        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/usb_device_filter" />

        <!--
          Foreground service for Bridge Mode operation.
          Keeps USB connection alive when app is backgrounded for GSPro relay.
          - connectedDevice: Used when GC2 is connected (requires USB permission grant)
          - dataSync: Used for GSPro testing without GC2 connected
        -->
        <service
            android:name=".GC2BridgeService"
            android:foregroundServiceType="connectedDevice|dataSync"
            android:exported="false" />
    </application>

</manifest>
